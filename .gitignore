# ===============================
# Final system delivery workspace
# Keep this folder tracked even though data/, outputs/, and *.csv are ignored globally.
# ===============================
!final_system/
!final_system/**

# Do not commit generated final_system outputs, but keep folder structure
final_system/data/outputs/*
!final_system/data/outputs/.gitkeep

# Do not commit instructor/private custom documents, but keep folder, README, and sample document
final_system/data/custom_documents/*
!final_system/data/custom_documents/.gitkeep
!final_system/data/custom_documents/README.md
!final_system/data/custom_documents/sample_legal_document.txt

# Do not commit local model adapters/weights, but keep folder structure
final_system/models/*
!final_system/models/.gitkeep